#!/bin/sh /etc/rc.common
# PorkChopCheck's own Tailscale: the router's tailscaled with its own state, socket and port, in
# userspace networking, so it runs in Router and Access point mode alike (GL.iNet's Tailscale only runs
# in Router mode). Turned on and off from the Deck's Tailscale page. Installed by router/install.sh.

START=95
STOP=05
USE_PROCD=1

start_service() {
	mkdir -p /etc/pcc-router/tailscale /var/run/pcc-tailscale
	chmod 700 /etc/pcc-router/tailscale
	procd_open_instance
	procd_set_param command /usr/sbin/tailscaled \
		--tun=userspace-networking \
		--socket=/var/run/pcc-tailscale/tailscaled.sock \
		--state=/etc/pcc-router/tailscale/tailscaled.state \
		--statedir=/etc/pcc-router/tailscale \
		--port=41642
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
